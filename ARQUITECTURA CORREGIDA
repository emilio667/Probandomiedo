from datetime import datetime

# 1. FUNCIÓN PARA CREAR LA ESTRUCTURA DE UN PRODUCTO
def crear_estructura_producto(
    id_prod: str,
    nombre: str,
    precio: float,  # Nota: En producción considera usar decimal.Decimal
    categoria: str,
    comercio_id: str,
    stock: int,
    atributos: dict  # Patrón de atributos para heterogeneidad
) -> dict:
    return {
        "_id": id_prod,
        "nombre": nombre,
        "precio": precio,
        "categoria": categoria,
        "comercio_id": comercio_id,
        "stock": stock,
        "atributos": atributos,
    }

# 2. FUNCIÓN PARA CREAR LA ESTRUCTURA DE UN CLIENTE
def crear_estructura_cliente(
    id_cliente: str,
    nombre: str,
    correo: str,
    telefono: str,
    cedula: str,
    direccion: dict
) -> dict:
    return {
        "_id": id_cliente,
        "nombre": nombre,
        "correo": correo,
        "telefono": telefono,
        "cedula": cedula,
        "direccion": direccion,
    }

# 3. FUNCIÓN PARA CREAR UN PEDIDO (Optimizado con datetime nativo)
def crear_estructura_pedido(
    id_pedido: str,
    cliente_id: str,
    estado: str,
    lineas_detalle: list[dict],
    fecha: datetime = None  # Usa objetos datetime nativos
) -> dict:
    if fecha is None:
        fecha = datetime.utcnow()  # Fecha y hora actual en UTC
        
    monto_total = sum(item["subtotal"] for item in lineas_detalle)
    
    return {
        "_id": id_pedido,
        "fecha": fecha,  # BSON Date en MongoDB
        "cliente_id": cliente_id,
        "estado": estado,
        "monto_total": monto_total,
        "lineas_detalle": lineas_detalle,
    }

